<html>
    <head>
        <title>class 20 demo</title>
        <link href="style.css" rel="stylesheet">
    </head>
    <body>
        <section class="left"></section>
        <form method="POST" action="/add-data">
            <input type="text" name="text" placeholder="add some text data" required>
            <input type="text" name="user" placeholder="add your name here" required>
            <input type="number" name="count" placeholder="add a number here">
            <input type="url" name="url" placeholder="add a link here">
            <input type="submit" value="send data">
        </form>
        <section class="right"></section>
    </body>
</html>